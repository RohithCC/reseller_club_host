# ═══════════════════════════════════════════════════════════════════════════
#  BACKEND ENVIRONMENT VARIABLES — Amulya Electronics
#  Location: backend/.env
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────
# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/amulya_electronics
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/amulya_electronics
MONGODB_URI=mongodb://127.0.0.1:27017/amulya_electronics

# ── Authentication ─────────────────────────────────────────────────────────
# JWT secret key — use a random 64-character string
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-64-character-secret-string-here-change-me

# Super admin credentials (used for first login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Google OAuth Client ID (for "Sign in with Google")
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ── Payments — Razorpay (Optional) ──────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email — Gmail SMTP (Optional) ──────────────────────────────────────────
# EMAIL_PASS = Gmail App Password (16 characters, no spaces)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# ── App Configuration ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PORT=10000
NODE_ENV=development
