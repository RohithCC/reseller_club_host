# ═══════════════════════════════════════════════════════════════════════════
#  CUSTOMER STOREFRONT ENVIRONMENT VARIABLES — Amulya Electronics
#  Location: amulyaelectronics/.env
# ═══════════════════════════════════════════════════════════════════════════

# Backend API URL (required)
VITE_BACKEND_URL=http://localhost:10000

# Google OAuth Client ID (required for Google login)
# Same value as GOOGLE_CLIENT_ID in backend/.env
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Google Maps API Key (optional — for checkout location picker)
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=

# Razorpay Key ID (optional — for online payments)
# Same value as RAZORPAY_KEY_ID in backend/.env
# Get from: https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=
